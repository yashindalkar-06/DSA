
#include <iostream>
using namespace std;
class Graph {
private:
 int vertices, adj[20][20];
public:
 Graph() {
 vertices = 0;
 for (int i = 0; i < 20; i++) {
 for (int j = 0; j < 20; j++) {
 adj[i][j] = 0;
 }
 }
 }
 void createGeaph() {
 int edges, source, destination;
 cout << "\nEnter number of vertices:"; cin >> vertices;
 for (int i = 0; i < vertices; i++) {
 for (int j = 0; j < vertices; j++) {
 adj[i][j] = 0;
 }
 }
 cout << "Enter number od edges: ";
 cin >> edges;
 cout << "\nEnter edges (source destination);\n";
 for (int i = 0; i < edges; i++) {
 cout << "Edge" << i + 1 << ":";
 cin >> source >> destination;
 if (source >= 0 && source < vertices && destination >= 0 &&
 destination < vertices) {
 adj[source][destination] = 1;
 adj[destination][source] = 1;
 } else {
 cout << "\nInvalid vertex number. \n";
 i--;
 }
 }
 cout << "\nGraph created successfully.\n";
 }
 void displayMatrix() {
 if (vertices == 0) { cout << "\nGraph is not created.\n";
 return;
 }
 cout << "\nAdjacency Matrix: \n\n";
 for (int i = 0; i < vertices; i++) {
 cout << i << " ";
 }
 cout << endl;
 // Display matrix
 for (int i = 0; i < vertices; i++) {
 cout << i << ": ";
 for (int j = 0; j < vertices; j++) {
 cout << adj[i][j] << " ";
 }
 cout << endl;
 }
 }
 void DFS(int startVertex) {
 if (vertices == 0) {
 cout << "\nGraph is not created.\n";
 return;
 }
 if (startVertex < 0 || startVertex >= vertices) {
 cout << "\nInvalid starting vertex.\n";
 return;
 }
 int visited[20];
 int stack[20]; int top = -1;
 for (int i = 0; i < vertices; i++) {
 visited[i] = 0;
 }
 top++;
 stack[top] = startVertex;
 cout << "\nDFS traversal:";
 while (top != -1) {
 int current = stack[top];
 top--;
 if (visited[current] == 0) {
 cout << current << " ";
 visited[current] = 1;
 for (int i = vertices - 1; i >= 0; i--) {
 if (adj[current][i] == 1 && visited[i] == 0) {
 top++;
 stack[top] = i;
 }
 }
 }
 }
 }
};
int main() {
 Graph g;
 int choice; do {
 cout << "\n======== Graph Menu ========" << endl;
 cout << "1. Create Graph" << endl;
 cout << "2. Display Adjacency Matrix" << endl;
 cout << "3. DFS Traversal" << endl;
 cout << "4. Exit" << endl;
 cout << "Enter your Choice :- ";
 cin >> choice;
 cin.ignore();
 switch (choice) {
 case 1:
 g.createGeaph();
 break;
 case 2:
 g.displayMatrix();
 break;
 case 3: {
 int startVertex;
 cout << "Enter starting vertex: ";
 cin >> startVertex;
 g.DFS(startVertex);
 break;
 }
 case 4:
 cout << "exit" << endl;
 break;
 default:
 cout << "Invalid Input" << endl; break;
 }
 } while (choice != 4);
 return 0;
}
