#include <iostream>
#include <stack>
using namespace std;
class Node
{
public:
 int data;
 Node *left;
 Node *right;
 Node(int value)
 {
 data = value;
 left = NULL;
 right = NULL;
 }
};
class BST
{
private:
 Node *root;
 Node *insert(Node *root, int value) {
 if (root == NULL)
 {
 return new Node(value);
 }
 if (value < root->data)
 {
 root->left = insert(root->left, value);
 }
 else if (value > root->data)
 {
 root->right = insert(root->right, value);
 }
 else
 {
 cout << "\nDuplicate value not inserted.\n";
 }
 return root;
 }
public:
 BST()
 {
 root = NULL;
 }
 void createBST()
 {
 int n, value; cout << "\nEnter number of nodes:";
 cin >> n;
 cout << "\nEnter node value:";
 for (int i = 1; i <= n; i++)
 {
 cin >> value;
 root = insert(root, value);
 }
 }
 int Hight(Node *root)
 {
 if (root == NULL)
 return 0;
 int leftHight = Hight(root->left);
 int rightHight = Hight(root->right);
 if (leftHight > rightHight)
 return leftHight + 1;
 else
 return rightHight + 1;
 }
 void DisplayHight()
 {
 cout << "hight of tree: " << Hight(root) << endl;
 }
 void leaves(Node *root)
 { if (root == NULL)
 return;
 if (root->left == NULL && root->right == NULL)
 {
 cout << root->data << ", ";
 return;
 }
 leaves(root->left);
 leaves(root->right);
 }
 void displayleaves(){
 leaves(root);
 }
 void displayLevelWise(){
 if(root==NULL){
 cout<<"\nTree is empty.\n";
 return;
 }
 Node*queue[100];
 int front = 0;
 int rear = 0;
 queue[rear] = root;
 rear++;
 cout<<"\nLevel-Wise BST:\n";
 while(front<rear){
 int nodesAtLevel = rear - front;
 cout << "Level: "; for (int i = 0; i < nodesAtLevel; i++)
 {
 Node *current = queue[front];
 front++;
 cout << current->data << " ";
 if (current->left != NULL)
 {
 queue[rear] = current->left;
 rear++;
 }
 if (current->right != NULL)
 {
 queue[rear] = current->right;
 rear++;
 }
 }
 }
 }
 Node* copyTree(Node* root){
 if(root==NULL){
 return NULL;
 }
 Node* newNode = new Node(root->data);
 newNode->left = copyTree(root->left);
 newNode->right = copyTree(root->right);
 return newNode;
 } BST* copyNewTree(){
 BST* newTree =new BST();
 newTree->root = copyTree(root);
 return newTree;
 }
};
int main()
{
 BST Tree;
 int choice;
 BST *newTree = NULL;
 if (newTree != NULL){
 delete newTree;
 newTree = NULL;
 }
 newTree = Tree.copyNewTree();
 
 do
 {
 cout << "\n========BST Tree========" << endl;
 cout << "1.Create Tree" << endl;
 cout << "2.display Hight" << endl;
 cout << "3.display leaves" << endl;
 cout << "4.display Level Wise " << endl;
 cout << "5.Copy display Hight" << endl;
 cout << "6.Copy display leaves" << endl;
 cout << "7.Copy display Level Wise " << endl; cout << "8.Exit" << endl;
 cout << "Enter your Choice :-";
 cin >> choice;
 cin.ignore();
 switch (choice)
 {
 case 1:
 Tree.createBST();
 break;
 case 2:
 Tree.DisplayHight();
 break;
 case 3:
 Tree.displayleaves();
 break;
 case 4:
 Tree.displayLevelWise();
 break;
 case 5:
 newTree->DisplayHight();
 break;
 case 6:
 newTree->displayLevelWise();
 break;
 case 7:
 newTree->displayleaves();
 break;
 case 8: cout << "exit" << endl;
 break;
 default:
 cout << "Invalid Input" << endl;
 break;
 }
 } while (choice != 8);
 return 0;
 
}
